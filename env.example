# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git or share it publicly.

# From your PayHero dashboard: the Basic Auth token you were given
# (Authorization: Basic <token>). Do NOT include the word "Basic" here.
PAYHERO_BASIC_TOKEN=

# From PayHero dashboard -> Payment Channels -> My Payment Channels
PAYHERO_CHANNEL_ID=

# The public URL PayHero will POST payment results to. This must be the
# real deployed address of THIS server, e.g.:
# https://housika-api.onrender.com/api/payhero-callback
PUBLIC_CALLBACK_URL=

PORT=4000
